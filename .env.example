PORT=3000
NODE_ENV=development
DB_PATH=./data/nestnavigator.sqlite
BACKUP_DIR=./backups
BACKUP_KEEP=7
BACKUP_INTERVAL_MS=86400000
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=12

# --- HTTPS ---
# Option A: the app terminates TLS itself (set both).
# TLS_KEY_FILE=./certs/key.pem
# TLS_CERT_FILE=./certs/cert.pem
# Option B: a reverse proxy / platform terminates TLS (Caddy, Render, Nginx...).
# TRUST_PROXY=true
# Either option: redirect HTTP -> HTTPS, send HSTS, mark cookies Secure.
# FORCE_HTTPS=true

# --- Email (password reset). Leave SMTP_HOST empty to print messages to the console instead. ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587            # 587 = STARTTLS, 465 with SMTP_SECURE=true
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="NestNavigator <no-reply@example.com>"
# LOG_REQUESTS=true        # one JSON access-log line per request (path only)
